<div class="container ccm-board-blog">
    <div class="row pb-4 mb-4">
        <div class="col-md-12 blog-featured-post">
            {{ slot.render(1) | raw }}
            <hr class="d-md-none d-block mb-0">
        </div>
    </div>
    <div class="row gx-8">
        <div class="col-md-8">
            {% if slot.hasContents(2) %}
            <div class="row">
                <div class="col-md-12">
                    {{ slot.render(2) | raw}}
                </div>
            </div>
            {% endif %}
            {% if slot.hasContents(3) %}
            <div class="row">
                <div class="col-md-12">
                    <hr class="d-none d-md-block">
                    {{ slot.render(3) | raw }}
                </div>
            </div>
            {% endif %}
            {% if slot.hasContents(4) %}
            <div class="row">
                <div class="col-md-12">
                    <hr class="d-none d-md-block">
                    {{ slot.render(4) | raw }}
                </div>
            </div>
            {% endif %}
            {% if slot.hasContents(5) %}
            <div class="row">
                <div class="col-md-12">
                    <hr class="d-none d-md-block">
                    {{ slot.render(5) | raw }}
                </div>
            </div>
            {% endif %}
        </div>
        <div class="col-md-4 col-blog-sidebar mt-3 mt-md-0">
            {{ Stack('Blog Sidebar') | raw}}
        </div>
    </div>
</div>
