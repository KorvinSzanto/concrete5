
<footer>
    <section class="mb-4">
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    {{ GlobalArea('Footer Column 1') | raw }}
                </div>
                <div class="col-md-2 col-6">
                    {{ GlobalArea('Footer Column 2') | raw }}
                </div>
                <div class="col-md-2 col-6">
                    {{ GlobalArea('Footer Column 3') | raw }}
                </div>
                <div class="col-md-5 col-12">
                    <hr class="d-md-none">
                    {{ GlobalArea('Footer Column 4') | raw }}
                </div>
            </div>
        </div>
    </section>
    <section class="concrete-branding">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                     {{ t('Copyright %s. ', now | date('Y')) }}
                    {{ t('Built with <strong><a href="https://www.concretecms.org" title="Concrete CMS" rel="nofollow">Concrete CMS</a></strong>.') | raw }}
                </div>
                <div class="col-md-6 text-md-end">
                    {{ app('helper/navigation').getLogInOutLink() | raw }}
                </div>
            </div>
        </div>
    </section>
</footer>